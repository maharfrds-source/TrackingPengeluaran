{
  "version": 2,
  "name": "tracking-pengeluaran",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://trackingpengeluaran.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://trackingpengeluaran.firebaseapp.com/__/firebase/:path*"
    }
  ]
}
